# Backend environment variables — DO NOT commit this file
# Copy to .env and fill in your real key

PORT=5000

# Groq API key — used for BOTH Whisper transcription AND LLM note generation.
# Get yours free at https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Frontend origin for CORS — set to your Vercel URL in production
FRONTEND_ORIGIN=http://localhost:5173

# Griot Nano 1 Sidecar Service URL (African-accented & Multilingual ASR)
GRIOT_SIDECAR_URL=http://localhost:8000

