# Backend environment variables — DO NOT commit this file
# Copy to .env and fill in your real keys

PORT=5000

# Groq API key for Whisper speech-to-text
GROQ_API_KEY=your_groq_api_key_here

# LLM API key for note generation (Groq/Claude/OpenAI)
LLM_API_KEY=your_llm_api_key_here

# Frontend origin (for CORS) — set to your Vercel URL in production
FRONTEND_ORIGIN=http://localhost:5173
